#!/usr/bin/env bash
# Land a feature branch on main with a semi-linear merge marker.
#
# Per the ethos in docs/design/project-principles.md: the branch must already
# be rebased onto main; it lands with a single --no-ff merge whose title is an
# imperative sentence, plus a parenthetical label only when there is something
# to cite, like 'Add CLI skeleton (Slice 0)'. Suggests titles via Haiku when
# the claude CLI is available, then cleans up the branch and its worktree.
#
# Usage: just land <branch>
set -euo pipefail

branch="${1:-}"
if [ -z "$branch" ] && command -v fzf >/dev/null 2>&1; then
    branch="$(git branch --format='%(refname:short)' | grep -vx main |
        fzf --prompt='land> ' --height=40% \
            --preview 'git log --oneline --reverse main..{}' || true)"
fi
if [ -z "$branch" ]; then
    echo "usage: just land <branch>" >&2
    exit 1
fi

current="$(git branch --show-current)"
[ "$current" = "main" ] || {
    echo "land: run from main (currently on $current)" >&2
    exit 1
}
if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "land: working tree is not clean" >&2
    exit 1
fi
git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null || {
    echo "land: no such branch: $branch" >&2
    exit 1
}
git merge-base --is-ancestor main "$branch" || {
    echo "land: $branch is not rebased onto main — rebase it in its worktree first" >&2
    exit 1
}

shortlog="$(git log "main..$branch" --oneline --reverse)"
[ -n "$shortlog" ] || {
    echo "land: $branch has no commits on top of main" >&2
    exit 1
}

echo "Landing $branch:"
sed 's/^/  /' <<<"$shortlog"
echo

# The agent that readied the branch may have left title suggestions behind;
# only ask Haiku live when it didn't.
suggestions=""
cache="$(git rev-parse --git-common-dir)/info/land-suggestions/$branch"
if [ -f "$cache" ]; then
    suggestions="$(head -3 "$cache")"
elif command -v claude >/dev/null 2>&1; then
    suggestions="$(claude -p --model haiku \
        "Suggest three candidate titles for the merge commit that lands these
        commits. Each title is a short imperative sentence, like 'Adopt
        semi-linear git history'. Append a parenthetical label only when the
        commits clearly implement a numbered roadmap slice, like 'Add CLI
        skeleton (Slice 0)'; otherwise no parenthetical. Reply with exactly
        three lines, one title per line, nothing else." \
        <<<"$shortlog" 2>/dev/null |
        sed -E '/^[[:space:]]*$/d; s/^[0-9]+[).][[:space:]]*//' | head -3 || true)"
fi

title=""
if [ -n "$suggestions" ] && command -v fzf >/dev/null 2>&1; then
    # --print-query emits the typed query on line 1, the pick (if any) on
    # line 2 — so picking a suggestion and typing your own use one widget.
    picked="$(fzf --print-query --prompt='title> ' --height=8 \
        --header='pick a title, or type your own and press enter' \
        <<<"$suggestions" || true)"
    title="$(sed -n 2p <<<"$picked")"
    [ -n "$title" ] || title="$(sed -n 1p <<<"$picked")"
elif [ -n "$suggestions" ]; then
    n=1
    while IFS= read -r line; do
        echo "  $n) $line"
        n=$((n + 1))
    done <<<"$suggestions"
    echo
    read -r -p "Title (1-3, or type your own): " choice
    case "$choice" in
    [1-3]) title="$(sed -n "${choice}p" <<<"$suggestions")" ;;
    *) title="$choice" ;;
    esac
else
    read -r -p "Title: " title
fi
[ -n "$title" ] || {
    echo "land: no title, nothing landed" >&2
    exit 1
}

git merge --no-ff --log=20 -m "$title" "$branch"

# Clean up the branch and its worktree. The non-force variants refuse dirty
# worktrees and unmerged branches, so nothing not already on main can be lost.
worktree="$(git worktree list --porcelain | grep -B2 "^branch refs/heads/$branch$" |
    sed -n 's/^worktree //p')"
if [ -n "$worktree" ]; then
    git worktree remove "$worktree"
fi
git branch -d "$branch"
rm -f "$cache"

echo "Landed: $(git log --oneline -1)"
